# Supabase (Project Settings → API). A chave anon/publishable é pública por design:
# a segurança vem das políticas RLS do banco.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública do site (canonical, sitemap, Open Graph, links do WhatsApp)
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# Calculadora de frete — cotação de Correios e transportadoras pelo Melhor Envio (opcional).
# Gere o token em https://melhorenvio.com.br/painel/gerenciar/tokens ("Novo token").
# Fica SOMENTE no servidor: nunca use o prefixo NEXT_PUBLIC_ nem salve o token no banco.
MELHOR_ENVIO_TOKEN=
# E-mail de contato que o Melhor Envio exige no User-Agent (padrão: e-mail de contato da loja)
MELHOR_ENVIO_EMAIL=
# true = ambiente de testes (sandbox.melhorenvio.com.br, com um token gerado no sandbox)
MELHOR_ENVIO_SANDBOX=false

# Pagamento pelo site — Mercado Pago Checkout Pro (opcional; também precisa ser ligado em Configurações).
# Access Token de PRODUÇÃO da aplicação (Suas integrações → aplicação → Credenciais de produção).
# Fica SOMENTE no servidor: nunca use o prefixo NEXT_PUBLIC_ nem salve no banco.
MERCADOPAGO_ACCESS_TOKEN=
# Assinatura secreta do webhook (Suas integrações → aplicação → Webhooks). Recusa avisos falsificados.
MERCADOPAGO_WEBHOOK_SECRET=

# Chave de serviço do Supabase (Project Settings → API Keys → service_role / secret).
# Usada SOMENTE no servidor, para gravar os pagamentos confirmados na API do Mercado Pago.
# Necessária apenas para o pagamento pelo site. Nunca use o prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Somente para testes locais: endereço do SDK do Mercado Pago (o padrão é https://sdk.mercadopago.com/js/v2).
# Não defina em produção.
# NEXT_PUBLIC_MERCADOPAGO_SDK_URL=

# Login com Google e Apple: configurado no painel do Supabase (Authentication → Providers), não aqui.
# Os segredos OAuth ficam no Supabase e nunca no site.
